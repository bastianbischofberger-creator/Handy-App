rules_version = '2';

// Firestore-Regeln für ASÜ-App, Mehrfachereignisse, Einsatzjournal, Schichtplanung, Einsatzbilder, Einsatzpläne und Einsatzdaten teilen (Projekt asue-e0f21)
// In der Firebase-Konsole unter Firestore > Regeln einfügen und «Veröffentlichen».
// WICHTIG: Zuerst diese Regeln veröffentlichen, erst danach die anonyme Anmeldung einschalten.
// «staff» = angemeldet mit E-Mail/Passwort (eure Konten). Anonyme Anmeldung (QR-Code im Depot)
// darf nur das laufende Ereignis sehen und sich selbst an-/abmelden – sonst nichts.

service cloud.firestore {
  match /databases/{database}/documents {

    // Zugelassene Konten fürs KP (iPads/Notebooks) – weitere Adressen in die Liste aufnehmen
    function staff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email in ['bastian.bischofberger@bluewin.ch'];
    }

    // ---------- ASÜ-App ----------
    match /einsaetze/{eid} {
      allow read, write: if staff();
      match /{path=**} { allow read, write: if staff(); }
    }
    match /config/{doc} {
      allow read, write: if staff();
    }
    // Geteilte Lage (QR-Code im Tableau): nur Gebäude + Trupps, ohne Namen; lesen mit Link (anonym)
    match /asue_public/{k} {
      allow read: if request.auth != null;
      allow write: if staff();
    }

    // ---------- Einsatzjournal ----------
    match /journale/{jid} {
      allow read, write: if staff();
      match /{path=**} { allow read, write: if staff(); }
    }

    // ---------- Mehrfachereignisse ----------
    // Laufendes Ereignis für die Anmeldeseite
    match /mf_public/{doc} {
      allow read: if request.auth != null;
      allow write: if staff();
    }
    function checkedIn(eid) {
      return request.auth != null && exists(/databases/$(database)/documents/mf_ereignisse/$(eid)/checkin/$(request.auth.uid));
    }
    match /mf_ereignisse/{eid} {
      allow read, write: if staff();
      match /{path=**} { allow read, write: if staff(); }

      // Anhänge: angemeldete AdF (QR) dürfen sie lesen
      match /files/{fid} {
        allow read: if checkedIn(eid);
        match /chunks/{c} { allow read: if checkedIn(eid); }
      }

      // Auftrag fürs Handy: jede Person liest nur ihren eigenen Eintrag
      match /inbox/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      // Anmeldung im Depot: jede Person nur ihren eigenen Eintrag, nur mit richtigem 4-stelligem Code
      match /checkin/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.code is string
          && request.resource.data.code == get(/databases/$(database)/documents/mf_ereignisse/$(eid)).data.code
          && get(/databases/$(database)/documents/mf_ereignisse/$(eid)).data.closed == false;
      }
    }

    // ---------- Schichtplanung (Brandwache) ----------
    // Plan lesen: Konten immer; AdF (anonym, per QR) nur solange «offen».
    // AdF dürfen sich nur selbst in eine freie Position eintragen (besetzte Position = Update = verboten)
    // und nur den eigenen Eintrag wieder löschen. Telefonnummern (kontakte) sieht nur das Konto.
    function spOffen(pid) {
      return get(/databases/$(database)/documents/sp_plaene/$(pid)).data.offen == true;
    }
    match /sp_plaene/{pid} {
      allow read: if staff() || (request.auth != null && resource.data.offen == true);
      allow write: if staff();
      match /eintraege/{sid} {
        allow read: if staff() || (request.auth != null && spOffen(pid));
        allow create: if staff() || (request.auth != null && spOffen(pid)
          && request.resource.data.keys().hasOnly(['slot', 'pos', 'name', 'uid', 'src', 't'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.src == 'qr'
          && request.resource.data.slot is int && request.resource.data.pos is int
          && request.resource.data.pos >= 1
          && request.resource.data.pos <= get(/databases/$(database)/documents/sp_plaene/$(pid)).data.adf
          && sid == string(request.resource.data.slot) + '_' + string(request.resource.data.pos)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60);
        allow update: if staff();
        allow delete: if staff() || (request.auth != null && resource.data.uid == request.auth.uid);
      }
      match /kontakte/{uid} {
        allow read: if staff() || (request.auth != null && request.auth.uid == uid);
        allow write: if staff() || (request.auth != null && request.auth.uid == uid && spOffen(pid)
          && request.resource.data.keys().hasOnly(['name', 'tel', 't'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.tel is string && request.resource.data.tel.size() <= 30);
      }
    }

    // ---------- Einsatzdaten teilen ----------
    // Dokument-ID = langer Zufallsschlüssel aus dem Link. Empfänger (anonym) dürfen nur genau diese
    // Freigabe lesen (get, kein Auflisten) und nur solange sie aktiv und nicht abgelaufen ist.
    match /sh_freigaben/{k} {
      allow get: if staff() || (request.auth != null && resource.data.aktiv == true && resource.data.bis > request.time.toMillis());
      allow list, write: if staff();
    }

    // ---------- Einsatzpläne ----------
    // Nur Konten (staff). Testphase: nur Testdaten – echte Pläne erst auf einem Schweizer Server.
    match /pl_objekte/{oid} {
      allow read, write: if staff();
      match /chunks/{c} { allow read, write: if staff(); }
    }

    // ---------- Einsatzbilder ----------
    // Konten: alles. AdF (anonym, per QR): Einsatz lesen und eigene Fotos hochladen, solange «offen».
    function biOffen(eid) {
      let e = get(/databases/$(database)/documents/bi_einsaetze/$(eid)).data;
      return e.offen == true && e.closed != true;
    }
    match /bi_einsaetze/{eid} {
      allow read: if staff() || (request.auth != null && resource.data.offen == true);
      allow write: if staff();
      match /fotos/{fid} {
        allow read: if staff() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if staff() || (request.auth != null && biOffen(eid)
          && request.resource.data.keys().hasOnly(['name', 't', 'by', 'w', 'h', 'n', 'size', 'thumb', 'src', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.src == 'qr'
          && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 6
          && request.resource.data.thumb is string && request.resource.data.thumb.size() < 60000
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.by is string && request.resource.data.by.size() <= 60);
        allow update, delete: if staff();
        match /chunks/{c} {
          allow read, update, delete: if staff();
          allow create: if staff() || (request.auth != null && biOffen(eid)
            && get(/databases/$(database)/documents/bi_einsaetze/$(eid)/fotos/$(fid)).data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['d'])
            && request.resource.data.d is string && request.resource.data.d.size() <= 700000);
        }
      }
    }
  }
}
